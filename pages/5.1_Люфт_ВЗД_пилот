import streamlit as st

st.header("🗜️ Модуль СМК: Входной контроль и дефектовка шпинделя ВЗД")
st.markdown("🎯 *Комплаенс ИНТИ S.QS.07 (п. 8.5.1.4 «Валидация процессов производства»)*")

# =================================================================
# БЛОК 1: КОНФИГУРАЦИОННАЯ МАТРИЦА (База ТУ Заказчиков и РЭ Завода)
# =================================================================
# Реальные лимиты эксплуатационного износа (Полевые ВИНК и Конструктивные РЭ)
limits_db = {
    "95 - 98 мм": {"passport": 4.5, "Роснефть": 4.5, "Газпром": 4.0},
    "120 - 127 мм": {"passport": 8.0, "Роснефть": 5.5, "Газпром": 5.0},
    "172 - 178 мм": {"passport": 9.0, "Роснефть": 6.5, "Газпром": 6.0}
}

# =================================================================
# БЛОК 2: ИНТЕРФЕЙС ВХОДНЫХ ФИЛЬТРОВ
# =================================================================
col_filters = st.columns(3)
with col_filters:
    client_vzd = st.selectbox("1. Выберите Заказчика по договору:", ["Роснефть", "Газпром"], key="client_vzd")
with col_filters:
    vzd_diameter = st.selectbox("2. Наружный диаметр (габарит) ВЗД:", list(limits_db.keys()), key="vzd_diameter")
with col_filters:
    st.write("") # Пустышка для выравнивания
    st.write("🏭 *Производитель: ООО 'Радиус-Сервис'*")

st.markdown("---")

# =================================================================
# БЛОК 3: ИНТЕРФЕЙС ЗАМЕРОВ ШТАНГЕНЦИРКУЛЕМ
# =================================================================
st.subheader("📏 Введите параметры фактических замеров шпинделя (мм):")
st.info("💡 **Физика процесса (Регламент СМК):** Фактический осевой люфт рассчитывается как разность замеров: **Размер А (Растянуто) - Размер Б (Сжато)**.")

col_inputs = st.columns(2)
with col_inputs:
    size_a = st.number_input("Размер А (Вал растянут под собственным весом КНБК):", value=10.00, step=0.01, format="%.2f")
with col_inputs:
    size_b = st.number_input("Размер Б (Вал полностью сжат на устье):", value=5.50, step=0.01, format="%.2f")

st.markdown("---")

# =================================================================
# БЛОК 4: МАТЕМАТИКА И ДВУХКОНТУРНАЯ ВАЛИДАЦИЯ
# =================================================================
# 1. Защита от дурака: проверка корректности ввода размеров
if size_b > size_a:
    st.error("🟥 **ОШИБКА ВВОДА ДАННЫХ!** Размер сжатия (Б) не может быть больше размера растяжения (А). Расчет заблокирован. Пожалуйста, перепроверьте замеры штангенциркулем.")
else:
    # 2. Вычисление фактического люфта
    fact_lyuft = size_a - size_b
    
    # 3. Извлечение лимитов из базы под текущий выбор
    selected_limits = limits_db[vzd_diameter]
    passport_limit = selected_limits["passport"]
    client_limit = selected_limits[client_vzd]
    
    # 4. МАГИЯ СМК: Двухконтурный выбор наименьшего (наиболее жесткого) окна допуска
    final_allowed_limit = min(passport_limit, client_limit)
    
    st.subheader("📊 Анализ результатов и Вердикт")
    
    # Выводим фактический замер на экран
    st.metric(label="Рассчитанный фактический осевой люфт шпинделя:", value=f"{fact_lyuft:.2f} мм")
    
    # 5. Сравнение факта с финальным жестким лимитом
    if fact_lyuft > final_allowed_limit:
        st.error(f"🟥 **ВЕРДИКТ СМК: ДВИГАТЕЛЬ ЗАБРАКОВАН! К повторному спуску ЗАПРЕЩЕН.**")
        
        # Динамическое объяснение причины блокировки
        if final_allowed_limit == passport_limit:
            st.warning(f"""
            **⚠️ ПРИЧИНА ОТБРАКОВКИ (Приоритет Паспорта ВЗД):**
            * Лимит Заказчика {client_vzd} составляет {client_limit} мм. Однако конструктивный предел разрушения по РЭ завода-изготовителя для данного габарита жестче — **{passport_limit} мм**.
            * **Решение системы:** В соответствии с регламентом СМК по предотвращению аварий и НПВ, приоритет отдан более жесткому критерию паспорта. Спуск инструмента приведет к слому шпинделя на забое!
            """)
        else:
            st.warning(f"""
            **⚠️ ПРИЧИНА ОТБРАКОВКИ (Приоритет Договора ВИНК):**
            * Предел по РЭ завода составляет {passport_limit} мм. Однако технические требования Заказчика {client_vzd} жестче — **{client_limit} мм**.
            * **Решение системы:** Превышен эксплуатационный лимит договора. Повторный спуск приведет к коммерческим штрафам и остановке работ со стороны супервайзера!
            """)
        
        st.info("📋 **Обязательное действие инженера ННБ:** Оформить официальный Акт дефектовки с указанием инвентарного номера ВЗД, вызвать резервное оборудование.")
            
    else:
        st.success(f"🟩 **ВЕРДИКТ СМК: ДВИГАТЕЛЬ ДОПУЩЕН К ПОВТОРНОМУ СПУСКУ.**")
        st.info(f"ℹ️ Фактический люфт {fact_lyuft:.2f} мм находится в безопасном диапазоне (Жесткий лимит комплаенса: не более {final_allowed_limit:.2f} мм).")

    # =================================================================
    # БЛОК 5: СПРАВОЧНЫЙ БЛОК ДЛЯ АУДИТОРОВ И ВАК (Стр. 4 диссертации)
    # =================================================================
    with st.expander("📚 Справочный блок метрологической валидации ИНТИ / ТУ:"):
        st.markdown(f"""
        * **Критический полевой лимит договора {client_vzd}:** {client_limit:.2f} мм.
        * **Предельный конструктивный износ по РЭ «Радиус-Сервис»:** {passport_limit:.2f} мм.
        * **Нормативный технологический зазор нового ВЗД (после ремонта на базе):** до 3.00 мм.
        * *🛡️ Расчетная матрица и алгоритмы двухконтурного комплаенса верифицированы технической службой завода-изготовителя (исх. № ХХХ от 2026 г.).*
        """)

